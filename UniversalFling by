-- Sistema de Lista Otimizado com Nick e Avatar Maiores
local playerButtons = {}

local function refreshPlayerList()
    local currentPlayers = Players:GetPlayers()
    local activePlayers = {}

    for _, p in ipairs(currentPlayers) do
        if p ~= LocalPlayer then
            table.insert(activePlayers, p)
        end
    end

    for p, btn in pairs(playerButtons) do
        if not table.find(activePlayers, p) then
            btn:Destroy()
            playerButtons[p] = nil
            if selectedTargetPlayer == p and isSpectating then
                stopSpectating()
            end
        end
    end

    for _, p in ipairs(activePlayers) do
        local pBtn = playerButtons[p]
        if not pBtn then
            pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -5, 0, 38)
            pBtn.BorderSizePixel = 0
            pBtn.Text = ""
            pBtn.Parent = PlayerScroll

            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = pBtn

            local AvatarBox = Instance.new("ImageLabel")
            AvatarBox.Name = "AvatarBox"
            AvatarBox.Size = UDim2.new(0, 32, 0, 32)
            AvatarBox.Position = UDim2.new(0, 3, 0.5, -16)
            AvatarBox.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            AvatarBox.BorderSizePixel = 0
            AvatarBox.Parent = pBtn

            local avatarCorner = Instance.new("UICorner")
            avatarCorner.CornerRadius = UDim.new(0, 4)
            avatarCorner.Parent = AvatarBox

            local NameLabel = Instance.new("TextLabel")
            NameLabel.Name = "NameLabel"
            NameLabel.Size = UDim2.new(1, -44, 1, 0)
            NameLabel.Position = UDim2.new(0, 41, 0, 0)
            NameLabel.BackgroundTransparency = 1
            NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            NameLabel.Font = Enum.Font.SourceSansBold
            NameLabel.TextSize = 15
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.Parent = pBtn

            task.spawn(function()
                pcall(function()
                    AvatarBox.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                end)
            end)

            pBtn.MouseButton1Click:Connect(function()
                selectedTargetPlayer = p
                if not isFlingingActive then
                    FlingButton.Text = "Fling: " .. p.Name
                end
                if isSpectating then
                    local tChar = p.Character
                    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    if tHum then
                        workspace.CurrentCamera.CameraSubject = tHum
                    end
                end
                refreshPlayerList()
            end)

            playerButtons[p] = pBtn
        end

        pBtn.BackgroundColor3 = (selectedTargetPlayer == p) and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(35, 35, 45)
        local nameLab = pBtn:FindFirstChild("NameLabel")
        if nameLab then nameLab.Text = p.Name end
    end

    PlayerScroll.CanvasSize = UDim2.new(0, 0, 0, #activePlayers * 42)
end

