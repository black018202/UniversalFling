FlingButton.MouseButton1Click:Connect(function()
    if not isFlingingActive then
        if not selectedTargetPlayer then
            FlingButton.Text = "Selecione!"
            task.wait(1)
            FlingButton.Text = "Fling: Selecione"
            return
        end

        isFlingingActive = true
        FlingButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        FlingButton.Text = "Parar Fling"

        task.spawn(function()
            while isFlingingActive and selectedTargetPlayer and selectedTargetPlayer.Parent == Players do
                flingPlayer(selectedTargetPlayer)
                task.wait(0.1)
            end

            if isFlingingActive then
                isFlingingActive = false
                FlingButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
                FlingButton.Text = selectedTargetPlayer and ("Fling: " .. selectedTargetPlayer.Name) or "Fling: Selecione"
            end
        end)
    else
        isFlingingActive = false
        FlingButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        FlingButton.Text = selectedTargetPlayer and ("Fling: " .. selectedTargetPlayer.Name) or "Fling: Selecione"
    end
end)
