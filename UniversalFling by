        if not selectedTargetPlayer then
            ViewButton.Text = "Selecione!"
            task.wait(1)
            ViewButton.Text = "View"
            return
        end
        local tChar = selectedTargetPlayer.Character
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
